<BoxContainer xmlns="https://spacestation14.io"
              xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
              xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
              MinSize="250 150"
              SetSize="250 150">
    <BoxContainer Name="CEnvironmentMix" Orientation="Vertical">
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BorderColor="#4f4f4f" />
            </PanelContainer.PanelOverride>
            <!-- The rest is filled by the Populate function to the DataContainer -->
            <BoxContainer Name="DataContainer" Orientation="Vertical" VerticalExpand="True" Margin="4"/>
        </PanelContainer>
        <controls:Placeholder Name="GasPlaceholder" Visible="False" PlaceholderText="{Loc 'gas-analyzer-window-no-data'}"/>
    </BoxContainer>
</BoxContainer>
