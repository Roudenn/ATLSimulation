<visuals:VisualsTab xmlns="https://spacestation14.io"
          xmlns:visuals="clr-namespace:Content.Client.UserInterface.Systems.Tabs">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8">
                <!-- Atmosphere -->
                <Label Text="{Loc 'ui-viewport-header-atmosphere'}" StyleClasses="LabelKeyText"/>
                <CheckBox Name="AtmosphereVisibilityCheckBox" Text="{Loc 'ui-viewport-tabs-visuals-atmosphere-visibility'}" />
                <CheckBox Name="AtmospherePressureCheckBox" Text="{Loc 'ui-viewport-tabs-visuals-atmosphere-pressure'}" />
                <CheckBox Name="AtmosphereSpeedCheckBox" Text="{Loc 'ui-viewport-tabs-visuals-atmosphere-speed'}" />

                <!-- Temperature & Solids -->
                <Label Text="{Loc 'ui-viewport-header-temperature'}" StyleClasses="LabelKeyText"/>
                <CheckBox Name="TemperatureVisibilityCheckBox" Text="{Loc 'ui-viewport-tabs-visuals-temperature-visibility'}" />

                <CheckBox Name="SolidsHeatCapacityCheckBox" Text="{Loc 'ui-ui-viewport-tabs-visuals-solids-heat-capacity'}" />
                <CheckBox Name="SolidsConductivityCheckBox" Text="{Loc 'ui-ui-viewport-tabs-visuals-solids-conductivity'}" />
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</visuals:VisualsTab>
