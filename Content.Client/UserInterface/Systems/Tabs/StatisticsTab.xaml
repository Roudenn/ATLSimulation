<visuals:StatisticsTab xmlns="https://spacestation14.io"
          xmlns:visuals="clr-namespace:Content.Client.UserInterface.Systems.Tabs"
          xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8">
                <!-- Main info -->
                <Label Text="{Loc 'ui-viewport-header-statistics'}" StyleClasses="LabelHeading"/>
                <BoxContainer Name="MainInfoContainer" Orientation="Vertical" Access="Public"/>
                <controls:StripeBack/>

                <!-- Inspect tools -->
                <Label Text="{Loc 'ui-viewport-header-inspect-tools'}" StyleClasses="LabelHeading"/>
                <controls:HeatInspectControl Name="HeatInspector" Visible="False" Access="Public"/>
                <controls:GasInspectControl Name="GasInspector" Visible="False" Access="Public"/>
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</visuals:StatisticsTab>
