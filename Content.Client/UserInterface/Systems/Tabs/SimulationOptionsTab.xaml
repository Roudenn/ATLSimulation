<visuals:SimulationOptionsTab xmlns="https://spacestation14.io"
          xmlns:visuals="clr-namespace:Content.Client.UserInterface.Systems.Tabs">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8">
                <!-- Maps -->
                <Label Text="{Loc 'ui-viewport-header-simulation-maps'}" StyleClasses="LabelHeading"/>
                <ItemList Name="Maps"
                          MinHeight="160"
                          HorizontalExpand="True"
                          SelectMode="Single"/>
                <Button Name="SelectMapButton" Text="{Loc 'ui-viewport-submit-map'}"/>
                <Button Name="RestartButton" Text="{Loc 'ui-viewport-restart'}"/>

                <Label Text="{Loc 'ui-viewport-header-simulation'}" StyleClasses="LabelHeading"/>

                <!-- TODO: CLIENT->SERVER OPTIONS -->

                <!-- Atmosphere -->
                <Label Text="{Loc 'ui-viewport-header-atmosphere'}" StyleClasses="LabelKeyText"/>

                <!-- Temperature -->
                <Label Text="{Loc 'ui-viewport-header-temperature'}" StyleClasses="LabelKeyText"/>


            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</visuals:SimulationOptionsTab>
